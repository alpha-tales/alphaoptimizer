{
  "name": "alphaoptimizer",
  "version": "0.1.0",
  "description": "Local Codex evidence optimizer prototype with durable retrieval and deterministic selection.",
  "main": "dist/src/server.js",
  "bin": {
    "alphaoptimizer": "dist/src/server.js"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "dist/src/",
    "docs/",
    "skills/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "hooks/",
    "scripts/start.mjs",
    "runtime-lock.json"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json && node dist/scripts/package-assets.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "eval": "tsx eval/run.ts",
    "compat": "tsx scripts/compatibility-probe.ts",
    "prepack": "npm run build",
    "compat:hooks": "tsx scripts/hook-host-probe.ts",
    "test:package": "tsx scripts/package-smoke.ts",
    "metrics": "node dist/src/telemetry/report.js",
    "compat:auto": "tsx scripts/auto-hook-probe.ts",
    "hooks:enable": "tsx scripts/enable-auto-hooks.ts",
    "hooks:disable": "tsx scripts/enable-auto-hooks.ts --disable",
    "package:plugin": "npm run build && tsx scripts/bundle-plugin.ts",
    "compat:plugin": "node dist/scripts/plugin-probe.js"
  },
  "keywords": [
    "codex",
    "mcp",
    "evidence",
    "retrieval"
  ],
  "author": "AlphaTales",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.2",
    "cross-spawn": "^7.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
